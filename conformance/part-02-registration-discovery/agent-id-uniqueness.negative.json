{
  "id": "p2-agent-id-uniqueness-001",
  "part": "agent-iam-2-registration-discovery",
  "clause": "5.1",
  "kind": "negative",
  "description": "Registering a second Agent with the same namespace and agentId must be rejected.",
  "input": {
    "operation": "register",
    "records": [
      {
        "namespace": "https://id.example.com/org/acme",
        "agentId": "agt_01JABCDEF0000000000000000",
        "agentClass": "service",
        "authorityBindingRef": "ab_01",
        "agentState": "registered",
        "agentEpoch": 0
      },
      {
        "namespace": "https://id.example.com/org/acme",
        "agentId": "agt_01JABCDEF0000000000000000",
        "agentClass": "service",
        "authorityBindingRef": "ab_02",
        "agentState": "registered",
        "agentEpoch": 0
      }
    ]
  },
  "expected": { "outcome": "reject", "reasonCode": "duplicate-agent-id" }
}
