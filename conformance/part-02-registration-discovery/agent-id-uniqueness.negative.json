        "authority_binding_ref": "ab_01",
        "lifecycle_state": "registered",
        "lifecycle_epoch": 0
      },
      {
        "namespace": "https://id.example.com/org/acme",
        "agent_id": "agt_01JABCDEF0000000000000000",
        "agent_class": "service",
        "authority_binding_ref": "ab_02",
        "lifecycle_state": "registered",
        "lifecycle_epoch": 0
      }
    ]
  },
  "expected": { "outcome": "reject", "reason_code": "duplicate-agent-id" }
