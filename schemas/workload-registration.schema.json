{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/workload-registration.schema.json",
  "title": "Workload Registration",
  "description": "Workload Registration record defined in Part 2 Section 5.5 of the Agent IAM Series.",
  "x-agent-iam-series-version": "0.4.1-draft",
  "x-agent-iam-part": "agent-iam-2-registration-discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "workloadRegistrationId",
    "platform",
    "selector",
    "trustDomain",
    "allowedProofMethods",
    "status"
  ],
  "properties": {
    "namespace": { "type": "string", "format": "uri" },
    "workloadRegistrationId": { "type": "string" },
    "platform": { "enum": ["spiffe", "kubernetes", "mtls", "rats_eat", "other"] },
    "selector": { "type": "object" },
    "trustDomain": { "type": "string" },
    "allowedProofMethods": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "status": { "enum": ["active", "suspended", "revoked"] },
    "proofRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "methods", "selectorSchemaVersion"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "profileVersion"],
            "properties": {
              "method": { "type": "string" },
              "profileVersion": { "type": "string" }
            }
          }
        },
        "selectorSchemaVersion": { "type": "string" },
        "expectedIssuer": { "type": "string" },
        "expectedAudience": { "type": "string" },
        "trustDomain": { "type": "string" },
        "attestationDigestRequired": { "type": "boolean" },
        "verifierIdentity": { "type": "string" }
      }
    }
  }
}
