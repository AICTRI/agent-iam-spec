{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/federation-trust.schema.json",
  "title": "Federation Trust",
  "description": "Namespace-scoped federation trust configuration defined in Part 5 Section 3.",
  "x-agent-iam-series-version": "0.3.0-draft",
  "x-agent-iam-part": "agent-iam-5-federation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "peerIssuer",
    "allowedAudiences",
    "claimMapping",
    "popRequirements",
    "trustStatus",
    "keyRefresh"
  ],
  "anyOf": [
    { "required": ["jwksUri"] },
    { "required": ["trustBundle"] }
  ],
  "properties": {
    "namespace": { "type": "string", "format": "uri" },
    "peerIssuer": { "type": "string", "format": "uri" },
    "jwksUri": { "type": "string", "format": "uri" },
    "trustBundle": { "type": "string" },
    "allowedAudiences": { "type": "array", "items": { "type": "string" } },
    "claimMapping": { "type": "object" },
    "popRequirements": { "type": "array", "items": { "type": "string" } },
    "trustStatus": { "enum": ["active", "disabled"] },
    "keyRefresh": {
      "type": "object",
      "properties": {
        "maxStaleSeconds": { "type": "integer", "minimum": 0 },
        "refreshIntervalSeconds": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
