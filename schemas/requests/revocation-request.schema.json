{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/requests/revocation-request.schema.json",
  "title": "Revocation Request",
  "description": "Namespace-scoped revocation request with a freshness class (Parts 3, 4, and 5).",
  "x-agent-iam-part": "agent-iam-4-authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "selectorType", "selectorValue", "freshnessClass"],
  "properties": {
    "namespace": { "type": "string", "format": "uri" },
    "selectorType": {
      "enum": [
        "agent",
        "instance",
        "credential",
        "agentEpoch", "identityEpoch",
        "workloadBinding",
        "attestationRef",
        "subject",
        "session",
        "authorityRoot",
        "decisionJti",
        "grantJti",
        "approvalJti",
        "policyVersion",
        "resourceDigest",
        "federationTrust"
      ]
    },
    "selectorValue": { "type": "string" },
    "freshnessClass": { "enum": ["pre_dispatch", "continuation", "connection"] }
  }
}
