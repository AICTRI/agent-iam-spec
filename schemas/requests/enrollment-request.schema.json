{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/requests/enrollment-request.schema.json",
  "title": "Enrollment Request",
  "description": "Request to enroll an Agent Instance (Part 3 Sections 4.1-4.4).",
  "x-agent-iam-part": "agent-iam-3-authentication",
  "type": "object",
  "additionalProperties": false,
  "required": ["agentId", "workloadRegistrationId", "workloadEvidence", "proof"],
  "properties": {
    "agentId": { "type": "string" },
    "workloadRegistrationId": { "type": "string" },
    "workloadEvidence": { "type": "object" },
    "proof": { "$ref": "../enrollment-proof.schema.json" }
  }
}
