{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/requests/exchange-request.schema.json",
  "title": "Token Exchange Request",
  "description": "OAuth token exchange request producing an attenuated grant (Part 4 Section 5.2).",
  "x-agent-iam-part": "agent-iam-4-authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["subjectToken", "requestedScope", "audience"],
  "properties": {
    "subjectToken": { "type": "string" },
    "requestedScope": { "type": "array", "items": { "type": "string" } },
    "audience": { "type": "string" },
    "task": { "type": "string" }
  }
}
