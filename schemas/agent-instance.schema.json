{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/agent-instance.schema.json",
  "title": "Agent Instance",
  "description": "Agent Instance record defined in Part 2 Section 5.6 of the Agent IAM Series.",
  "x-agent-iam-series-version": "0.3.0-draft",
  "x-agent-iam-part": "agent-iam-2-registration-discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "instanceId",
    "agentId",
    "workloadRegistrationId",
    "workloadId",
    "attestationRef",
    "credentialGeneration",
    "instanceState"
  ],
  "properties": {
    "namespace": { "type": "string", "format": "uri" },
    "instanceId": { "type": "string" },
    "agentId": { "type": "string" },
    "workloadRegistrationId": { "type": "string" },
    "workloadId": { "type": "string" },
    "artifactDigest": { "type": "string" },
    "attestationRef": {
      "type": "string",
      "description": "Must correlate to an actual verification result (Part 2 Section 5.6)."
    },
    "credentialGeneration": { "type": "integer", "minimum": 0 },
    "leaseExpiresAt": { "type": "string", "format": "date-time" },
    "instanceState": { "enum": ["bound", "active", "expired", "terminated"] }
  }
}
