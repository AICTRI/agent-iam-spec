{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/discovery-document.schema.json",
  "title": "Discovery Document",
  "description": "Authority Namespace discovery document defined in Part 2 Section 8.2.",
  "x-agent-iam-series-version": "0.4.1-draft",
  "x-agent-iam-part": "agent-iam-2-registration-discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "discoveryVersion",
    "namespace",
    "issuer",
    "jwksUri",
    "supportedProofProfiles",
    "supportedArtifactTypes",
    "keyRotation"
  ],
  "properties": {
    "discoveryVersion": { "type": "string" },
    "namespace": { "type": "string", "format": "uri" },
    "issuer": { "type": "string", "format": "uri" },
    "registryEndpoint": { "type": "string", "format": "uri" },
    "jwksUri": { "type": "string", "format": "uri" },
    "supportedProofProfiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supportedArtifactTypes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conformanceClaimRef": { "type": "string" },
    "keyRotation": {
      "type": "object",
      "properties": {
        "overlapSeconds": { "type": "integer", "minimum": 0 },
        "propagationSeconds": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
