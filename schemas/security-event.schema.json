{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/security-event.schema.json",
  "title": "Security Event Record",
  "description": "Audit security event record defined in Part 6 Section 4.",
  "x-agent-iam-series-version": "0.4.1-draft",
  "x-agent-iam-part": "agent-iam-6-audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "timestamp", "namespace", "traceId", "outcome", "reasonCode"],
  "properties": {
    "eventId": { "type": "string" },
    "eventType": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "namespace": { "type": "string", "format": "uri" },
    "agentId": { "type": "string" },
    "instanceId": { "type": "string" },
    "subject": { "type": "string" },
    "actor": { "type": "string" },
    "client": { "type": "string" },
    "workload": { "type": "string" },
    "agentEpoch": { "type": "integer", "minimum": 0 }, "identityEpoch": { "type": "integer", "minimum": 0 },
    "action": { "type": "string" },
    "resourceDigest": { "type": "string" },
    "policyVersion": { "type": "string" },
    "decisionId": { "type": "string" },
    "grantId": { "type": "string" },
    "approvalId": { "type": "string" },
    "traceId": { "type": "string" },
    "outcome": { "type": "string" },
    "reasonCode": { "type": "string" },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } }
  }
}
