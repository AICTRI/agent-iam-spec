{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/security-event.schema.json",
  "title": "Security Event Record",
  "description": "Audit security event record defined in Part 6 Section 4.",
  "x-agent-iam-series-version": "0.1.0-draft",
  "x-agent-iam-part": "agent-iam-6-audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "timestamp", "namespace", "trace_id", "outcome", "reason_code"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "namespace": { "type": "string", "format": "uri" },
    "agent_id": { "type": "string" },
    "instance_id": { "type": "string" },
    "subject": { "type": "string" },
    "actor": { "type": "string" },
    "client": { "type": "string" },
    "workload": { "type": "string" },
    "lifecycle_epoch": { "type": "integer", "minimum": 0 },
    "action": { "type": "string" },
    "resource_digest": { "type": "string" },
    "policy_version": { "type": "string" },
    "decision_id": { "type": "string" },
    "grant_id": { "type": "string" },
    "approval_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "outcome": { "type": "string" },
    "reason_code": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } }
  }
}
