{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/identity-token.schema.json",
  "title": "Local Agent Identity Token Claims",
  "description": "Proof-of-possession identity token claims defined in Part 3 Section 5.1.",
  "x-agent-iam-series-version": "0.4.0-draft",
  "x-agent-iam-part": "agent-iam-3-authentication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss",
    "sub",
    "aud",
    "iat",
    "exp",
    "jti",
    "namespace",
    "agentClass",
    "instanceId",
    "workloadId",
    "authorityRootRef",
    "agentEpoch", "identityEpoch",
    "cnf"
  ],
  "properties": {
    "iss": { "type": "string" },
    "sub": { "type": "string" },
    "aud": { "type": "string" },
    "iat": { "type": "integer" },
    "exp": { "type": "integer" },
    "jti": { "type": "string" },
    "namespace": { "type": "string", "format": "uri" },
    "agentClass": { "enum": ["embedded", "organizational", "user", "assetTwin", "personalTwin", "twin", "service", "ephemeral", "simulation"] },
    "instanceId": { "type": "string" },
    "workloadId": { "type": "string" },
    "authorityRootRef": { "type": "string" },
    "agentEpoch": { "type": "integer", "minimum": 0 }, "identityEpoch": { "type": "integer", "minimum": 0 },
    "cnf": {
      "type": "object",
      "description": "Key confirmation, for example { \"jkt\": \"...\" }.",
      "properties": { "jkt": { "type": "string" } },
      "required": ["jkt"]
    }
  }
}
