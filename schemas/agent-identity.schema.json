{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AICTRI/agent-iam-spec/schemas/agent-identity.schema.json",
  "title": "Agent Identity Record",
  "description": "Agent Identity record defined in Part 2 Section 5.1 of the Agent IAM Series.",
  "x-agent-iam-series-version": "0.4.1-draft",
  "x-agent-iam-part": "agent-iam-2-registration-discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "agentId",
    "agentClass",
    "authorityBindingRef",
    "agentState",
    "agentEpoch", "identityEpoch"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "format": "uri",
      "description": "Canonical Authority Namespace (Part 2 Section 4.3)."
    },
    "agentId": {
      "type": "string",
      "pattern": "^agt_[A-Za-z0-9_-]+$",
      "description": "Opaque local Agent ID, unique within the namespace."
    },
    "agentClass": { "enum": ["embedded", "organizational", "user", "assetTwin", "personalTwin", "twin", "service", "ephemeral", "simulation"] },
    "blueprintId": { "type": "string" },
    "blueprintVersion": { "type": "string" },
    "authorityBindingRef": { "type": "string" },
    "sponsorRef": { "type": "string" },
    "agentState": {
      "enum": ["registered", "enrolled", "active", "suspended", "revoked"]
    },
    "agentEpoch": { "type": "integer", "minimum": 0 }, "identityEpoch": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
